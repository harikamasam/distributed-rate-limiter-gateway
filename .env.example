# Docker Compose service name. For a host-run uvicorn process, use localhost.
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1
# closed is safest: Redis failure returns 503 instead of unlimited access.
REDIS_FAILURE_MODE=closed
CORS_ORIGINS=http://localhost:8000
# Development-only examples. Use secret values outside local development.
API_KEYS=free-key-123:free,premium-key-456:premium
FREE_CAPACITY=5
FREE_REFILL_RATE=1
PREMIUM_CAPACITY=50
PREMIUM_REFILL_RATE=10
ADMIN_CAPACITY=100
ADMIN_REFILL_RATE=25
